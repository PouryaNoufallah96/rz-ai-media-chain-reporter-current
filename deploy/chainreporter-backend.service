[Unit]
Description=ChainReporter Python Backend (port 3001)
After=network.target

[Service]
Type=simple
User=www-data
WorkingDirectory=/var/www/chainreporter/backend
ExecStart=/usr/bin/python3 server.py
Restart=on-failure
RestartSec=5
EnvironmentFile=/var/www/chainreporter/backend/.env

[Install]
WantedBy=multi-user.target
