# ── Required (all AI calls — chat, embeddings, images — route through OpenRouter) ──
OPENROUTER_API_KEY=sk-or-...

# ── CORS / Origin ──────────────────────────────────────────────────────────────
# localhost:  leave as * (default) or set to http://localhost:3000
# VPS:        set to http://5.75.207.209  (or your domain once DNS is set)
# Production: set to https://yourdomain.com
FRONTEND_ORIGIN=*

# ── Google integrations ────────────────────────────────────────────────────────
GOOGLE_APPS_SCRIPT_URL=https://script.google.com/macros/s/.../exec
GOOGLE_DRIVE_FOLDER_URL=https://drive.google.com/drive/folders/...

# ── Telegram ───────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL=@chainreporternews
TELEGRAM_PROXY=                      # e.g. http://127.0.0.1:10808 — only if VPS is in a restricted region

# ── X (Twitter) ────────────────────────────────────────────────────────────────
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
X_BEARER_TOKEN=

# ── Server ─────────────────────────────────────────────────────────────────────
PORT=3001

# Private local EmbeddingGemma service used only by /api/chat.
# The chatbot rejects non-loopback URLs and never falls back to OpenRouter.
CHAT_EMBEDDING_URL=http://127.0.0.1:8081
CHAT_EMBEDDING_TIMEOUT=3
CHAT_EMBEDDING_DIMENSION=768

# ── Auth ───────────────────────────────────────────────────────────────────────
# Set to true only when served over HTTPS (adds the Secure flag to the session
# cookie). Leave unset/false for local http:// dev — Secure cookies are dropped
# by browsers over plain HTTP.
COOKIE_SECURE=

# ── Embedding cache (optional — leave blank to use default path) ──────────────
# Default: <backend>/data/embed_cache.pkl  (relative to embedder.py, CWD-safe)
# Override on VPS if you want the cache in a specific directory:
EMBED_CACHE_PATH=

# ── Screenshot tool ────────────────────────────────────────────────────────────
# Used by screenshot.mjs when no URL is passed as argument
# localhost: leave blank (defaults to http://localhost:3000)
# VPS:       APP_URL=http://5.75.207.209/login
APP_URL=
